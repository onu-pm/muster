# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose this to the browser. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM, via OpenRouter (BYOK) ---
# OpenRouter account -> Settings -> Integrations -> add your own Anthropic key (BYOK).
# This is the OpenRouter key your app authenticates with, not your Anthropic key directly.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Model tiering (see "On cost" in the Muster doc) — both free-tier NVIDIA Nemotron 3 models on
# OpenRouter, no Anthropic key or OpenRouter balance required.
MODEL_ROUTINE=nvidia/nemotron-3-super-120b-a12b:free
MODEL_JUDGMENT=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Remote.com (optional — real attendance/leave data for the Input agent) ---
# Company Settings -> Integrations & APIs -> Remote API -> Generate API token.
# Sandbox tokens start with ra_test_, production with ra_live_ — the two are
# fully isolated. Leave both unset and the Input agent reconciles whatever
# rows you pass it directly (see README's curl example), same as before.
REMOTE_API_TOKEN=
REMOTE_API_BASE_URL=https://gateway.remote-sandbox.com
