# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose this to the browser. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM, via OpenRouter (BYOK) ---
# OpenRouter account -> Settings -> Integrations -> add your own Anthropic key (BYOK).
# This is the OpenRouter key your app authenticates with, not your Anthropic key directly.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Model tiering (see "On cost" in the Muster doc) — Haiku for routine calls, Sonnet for hard judgment.
MODEL_ROUTINE=anthropic/claude-haiku-4.5
MODEL_JUDGMENT=anthropic/claude-sonnet-5
